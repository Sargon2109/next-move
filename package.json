{
  "name": "next-move",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bindings": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "publish:cloud": "spacetime publish",
    "publish:local": "spacetime publish --server local"
  },
  "dependencies": {
    "spacetimedb": "2.14.*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  }
}
